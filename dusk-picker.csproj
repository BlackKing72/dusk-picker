<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Whether the app is framework dependent or not -->
    <SelfContained>true</SelfContained>
    <!-- Enable ahead of time compilation i.e native builds -->
    <PublishAot>true</PublishAot>
    <!-- Set application icon (seems to only work on Windows) -->
    <ApplicationIcon>assets/dusk.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.HighPerformance" Version="8.4.0" />
    <PackageReference Include="Hexa.NET.ImGui" Version="2.2.2" />
    <PackageReference Include="Raylib-cs" Version="7.0.2" />
    <PackageReference Include="Shutter" Version="1.0.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.1" />
  </ItemGroup>
  <!-- Embedded Assets -->
  <ItemGroup>
    <EmbeddedResource Include="assets/**" LinkBase="" />
  </ItemGroup>
</Project>
